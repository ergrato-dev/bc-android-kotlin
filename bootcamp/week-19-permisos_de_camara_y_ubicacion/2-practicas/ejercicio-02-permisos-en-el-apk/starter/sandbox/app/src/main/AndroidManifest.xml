<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Paso 1: los permisos de ubicación (aproximada y precisa) y el de la cámara. -->
    <!-- Paso 2: quita el permiso de los contactos que trae el SDK (tools:node="remove"). -->
    <!-- Paso 3: la cámara y la ubicación como funciones no obligatorias (uses-feature). -->
    <application android:label="@string/app_name">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Paso 4: el FileProvider de androidx.core para compartir las fotos con la app de la cámara. -->
    </application>

</manifest>
